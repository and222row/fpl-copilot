# Copy to .env.local for local development.
#
# Must be NEXT_PUBLIC_ — it is read in the browser (src/lib/api.ts:1), not on
# the server. Anything without that prefix is stripped from the client bundle
# and the fetch would fall back to localhost.
#
# Local:  http://localhost:8000
# Vercel: set this in Project → Settings → Environment Variables to the Render
#         URL, e.g. https://fpl-copilot-api.onrender.com  (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000
