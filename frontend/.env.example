# Copy to .env.local for local development.
#
# Everything here is NEXT_PUBLIC_: read in the browser and compiled into the
# bundle, so public values only. Never put a service key or secret here.
#
# Local:  http://localhost:8000
# Vercel: set these in Project → Settings → Environment Variables. The API is
#         the Render URL, e.g. https://fpl-copilot-api.onrender.com (no slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase → Project Settings → API: project URL and the PUBLISHABLE key, the
# same project as the mobile app. Add the site's URL (and your local origin,
# e.g. http://localhost:3000) under Authentication → URL Configuration →
# Redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=
