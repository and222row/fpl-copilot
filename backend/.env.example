# Copy this file to .env and fill in your values

# ── PostgreSQL (get from Supabase → Settings → Database → URI) ──────────────
# Replace [YOUR-PASSWORD] with your actual Supabase DB password
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Redis (get from Upstash → your database → Details → REDIS_URL) ──────────
REDIS_URL=rediss://:[YOUR-UPSTASH-PASSWORD]@[YOUR-UPSTASH-HOST].upstash.io:6380

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── CORS (frontend URL) ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── External APIs (fill in when ready) ───────────────────────────────────────
ANTHROPIC_API_KEY=
API_FOOTBALL_KEY=

# ── Background refresh ───────────────────────────────────────────────────────
# In-process scheduler. Only works where the process stays alive; on a free tier
# that sleeps, use an external cron against POST /api/v1/jobs/refresh instead.
SCHEDULER_ENABLED=false
REFRESH_INTERVAL_MINUTES=30

# Shared secret for the job endpoint. Empty = no auth (fine locally).
# Set this before exposing the API publicly.
JOB_TOKEN=

# ── FPL response cache (Redis) ───────────────────────────────────────────────
# Collapses the duplicate manager lookups a single dashboard load produces —
# the squad view, state banner, recommendation and planner each resolve the
# squad independently, so FPL sees four identical requests without this.
#
# Short on purpose: the picks response also carries live points and rank.
# The bootstrap is never cached at any TTL — see app/services/cache.py.
CACHE_ENABLED=true
FPL_CACHE_TTL_SECONDS=90
