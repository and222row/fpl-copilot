# Copy this file to .env and fill in your values

# ── PostgreSQL (get from Supabase → Settings → Database → URI) ──────────────
# Replace [YOUR-PASSWORD] with your actual Supabase DB password
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Redis (get from Upstash → your database → Details → REDIS_URL) ──────────
REDIS_URL=rediss://:[YOUR-UPSTASH-PASSWORD]@[YOUR-UPSTASH-HOST].upstash.io:6380

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── CORS (frontend URL) ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── External APIs (fill in when ready) ───────────────────────────────────────
ANTHROPIC_API_KEY=
API_FOOTBALL_KEY=

# ── Background refresh ───────────────────────────────────────────────────────
# In-process scheduler. Only works where the process stays alive; on a free tier
# that sleeps, use an external cron against POST /api/v1/jobs/refresh instead.
SCHEDULER_ENABLED=false
REFRESH_INTERVAL_MINUTES=30

# Shared secret for the job endpoint. Empty = no auth (fine locally).
# Set this before exposing the API publicly.
JOB_TOKEN=

# ── FPL response cache (Redis) ───────────────────────────────────────────────
# Collapses the duplicate manager lookups a single dashboard load produces —
# the squad view, state banner, recommendation and planner each resolve the
# squad independently, so FPL sees four identical requests without this.
#
# Short on purpose: the picks response also carries live points and rank.
# The bootstrap is never cached at any TTL — see app/services/cache.py.
CACHE_ENABLED=true
FPL_CACHE_TTL_SECONDS=90

# ── QStash scheduling (scripts/qstash_schedule.py) ───────────────────────────
# GitHub Actions' cron is best-effort and drops most slots — measured at 7 runs
# a day against 100 configured. QStash runs a real schedule and retries failed
# deliveries. Token comes from the Upstash console -> QStash.
API_BASE_URL=https://your-api.onrender.com
QSTASH_TOKEN=

# ── Telegram alerts (opt-in per manager) ─────────────────────────────────────
# Alerts are computed every refresh and stored, but without this they only
# appear in the dashboard — you have to think to look. Delivery is opt-in per
# manager and revocable from the website.
#
# Setup:
#   1. Message @BotFather in Telegram -> /newbot -> copy the token here
#   2. python scripts/telegram_setup.py whoami        (verify the token)
#   3. python scripts/telegram_setup.py set-webhook   (generates the secret)
#   4. Copy both values into the Render environment
TELEGRAM_BOT_TOKEN=
# Echoed by Telegram in X-Telegram-Bot-Api-Secret-Token. Without it the webhook
# would accept forged updates and let anyone bind their chat to any squad.
# `set-webhook` generates one if it is blank.
TELEGRAM_WEBHOOK_SECRET=
# `info` is real but not worth a phone buzz; sending it teaches people to mute.
TELEGRAM_MIN_SEVERITIES=critical,warning

# ── User authentication (Supabase Auth) ──────────────────────────────────────
# Project URL from Supabase -> Project Settings -> API. Tokens are verified
# against its JWKS (asymmetric signing keys). Empty = every token is rejected.
SUPABASE_URL=
# Only for projects still on the legacy shared HS256 JWT secret. Leave empty if
# the project uses signing keys. Server-side only, never ship it to a client.
SUPABASE_JWT_SECRET=
# false: requests with no token still reach per-team routes (the web dashboard
# has no login yet). Tokens that ARE sent are always enforced. Set true before
# the mobile app launches.
AUTH_REQUIRED=false
