# Copy to .env (git-ignored). Everything prefixed EXPO_PUBLIC_ is compiled into
# the app and readable by anyone who downloads it, so only public values belong
# here. Never put a database URL, JWT secret, service-role key, Stripe secret or
# any other backend credential in this file.

# FastAPI backend. http://<your-LAN-IP>:8000 works for a dev build on a phone;
# release builds refuse anything that is not https.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Supabase -> Project Settings -> API: project URL and the PUBLISHABLE (anon)
# key. Not the service_role / secret key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=

# Google Cloud Console -> Credentials. The web client ID is the one also entered
# in Supabase -> Auth -> Providers -> Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# The iOS client ID reversed, e.g. com.googleusercontent.apps.1234-abcd
GOOGLE_IOS_URL_SCHEME=

# RevenueCat -> Project settings -> API keys: the PUBLIC app-specific keys
# (appl_... for iOS, goog_... for Android). Never the secret sk_... key.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
