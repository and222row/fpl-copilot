{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "e2e": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_E2E": "true"
      },
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_E2E": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
